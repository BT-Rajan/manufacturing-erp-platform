# Copy to .env and adjust. See src/core/config/settings.ts for the full,
# authoritative list -- this file is documentation, not the source of truth.

NODE_ENV=development
PORT=8000

DB_HOST=localhost
DB_PORT=3306
DB_USER=erp_user
DB_PASSWORD=erp_pass
DB_NAME=erp_platform

JWT_SECRET_KEY=change-me-in-env
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173

# Bootstrap-only branding defaults. From Pass 4 onward these become
# admin-editable at runtime via the settings domain, stored in MySQL --
# not redeployed. These env values only seed the initial tenant record
# on first boot.
BRAND_NAME=Manufacturing ERP
BRAND_LOGO_URL=
BRAND_PRIMARY_COLOR=#1f2937
